{
  "name": "@platform/reference-napplet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "napplet": {
    "dTag": "reference-napplet",
    "title": "Reference Napplet",
    "requires": [
      "identity"
    ],
    "archetypes": [
      {
        "slug": "reference",
        "convention": "napplet:reference/open"
      }
    ]
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "check": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "verify": "pnpm type-check && pnpm build",
    "test:conformance": "pnpm build && napplet-conformance ./dist"
  },
  "dependencies": {
    "@napplet/sdk": "0.27.2"
  },
  "devDependencies": {
    "@napplet/conformance-cli": "0.2.18",
    "@napplet/vite-plugin": "0.14.1",
    "vite": "7.1.3"
  }
}
