{
  "name": "@platform/view-problem-napplet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "napplet": {
    "dTag": "view-problem",
    "title": "View Problem",
    "requires": ["identity", "outbox", "resource", "intent", "inc"],
    "archetypes": [
      {
        "slug": "note",
        "convention": "napplet:note/open"
      }
    ]
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "pnpm build && playwright test --config playwright.config.ts",
    "verify": "pnpm type-check && pnpm test && pnpm build",
    "test:conformance": "pnpm build && napplet-conformance ./dist"
  },
  "dependencies": {
    "@napplet/sdk": "0.27.2",
    "gsap": "3.15.0",
    "nostr-tools": "2.24.0"
  },
  "devDependencies": {
    "@napplet/conformance-cli": "0.2.18",
    "@napplet/vite-plugin": "0.14.1",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "vitest": "3.2.4"
  }
}
